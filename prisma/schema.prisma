// Prisma schema for EVE Healthcare API
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]

  @@map("users")
}

model DiagnosticCentre {
  id          String       @id @default(uuid())
  name        String
  location    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  centreTests CentreTest[]

  @@map("diagnostic_centres")
}

model DiagnosticTest {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  centreTests CentreTest[]

  @@map("diagnostic_tests")
}

model CentreTest {
  id        String           @id @default(uuid())
  centreId  String
  testId    String
  price     Decimal          @db.Decimal(10, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  centre    DiagnosticCentre @relation(fields: [centreId], references: [id], onDelete: Restrict)
  test      DiagnosticTest   @relation(fields: [testId], references: [id], onDelete: Restrict)
  bookings  Booking[]

  @@unique([centreId, testId])
  @@index([centreId])
  @@index([testId])
  @@map("centre_tests")
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  centreTestId  String
  appointmentAt DateTime
  amount        Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  centreTest    CentreTest    @relation(fields: [centreTestId], references: [id], onDelete: Restrict)
  payment       Payment?

  @@index([userId])
  @@index([centreTestId])
  @@index([status])
  @@index([appointmentAt])
  @@map("bookings")
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  providerPaymentId String        @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("payments")
}
